# Required unless MOCK_GRADING=true
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required for all protected API endpoints
TEACHER_API_KEY=choose-a-strong-shared-key-here

# Database connection (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./scriptgrader.db

# Set true to run without calling a real model (dev/demo only)
MOCK_GRADING=false

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8000

# Rate limit for the grading endpoint
RATE_LIMIT_GRADE=10/minute

# Upload constraints
MAX_UPLOAD_MB=10
MAX_IMAGE_DIMENSION=4096

# Only used when running via Docker Compose with the Postgres service
POSTGRES_PASSWORD=change-me
